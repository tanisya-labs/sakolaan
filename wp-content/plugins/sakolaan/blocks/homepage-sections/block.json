{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sakolaan-theme/homepage-sections",
	"title": "Susunan Beranda",
	"category": "theme",
	"description": "Merender section beranda sesuai urutan pada Pengaturan Sakolaan.",
	"icon": "sort",
	"textdomain": "sakolaan",
	"supports": {
		"autoRegister": true,
		"html": false,
		"color": { "background": true, "text": true, "link": true },
		"typography": { "fontSize": true, "fontFamily": true }
	},
	"attributes": {
		"sectionLayouts": { "type": "object", "default": {} },
		"sakolaanLayoutSection": { "type": "string", "default": "news" }
	},
	"editorScript": "file:./editor.js",
	"render": "file:./render.php"
}
